PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# Shared secret for /api/v1 (sent as "Authorization: Bearer <key>" or "X-API-Key").
# Required unless NODE_ENV is not production.
API_KEY=change-me
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
# Host-side URL; docker compose overrides it for the api container.
COUCHDB_URL=http://admin:change-me@localhost:5984
COUCHDB_NAME=open-replay
COUCHDB_PORT=5984

# The TAMS store recordings are read from, and the OSC access token it needs (exchanged for short-lived tokens).
# Optional: without them /api/v1/streams answers 503.
TAMS_GATEWAY_URL=https://your-tams-gateway.example.com
# TAMS_SERVICE_ID=eyevinn-tams-gateway
OSC_ACCESS_TOKEN=

# The Strom that runs replays, and its key if it needs one (sent as a Bearer token; leave empty for a local Strom).
# The browser reaches Strom only through /api/v1/strom, which adds the key. Optional: without STROM_URL the
# /api/v1/groups/:id/playback routes answer 503.
STROM_URL=http://localhost:8080
STROM_AUTH_TOKEN=

# Which encoders replay flows ask Strom for: auto (hardware first, then software; the default), hardware, or software.
# ENCODER_PREFERENCE=auto

# How far behind the live edge a started replay plays, in ms (Strom's `live` command). The backend sends `live`
# itself after starting a replay, because a new replay group starts paused. Lower is less delay and less room for a
# late segment: with 500 ms segments, 800 was clean; with 1 s segments use 1000 or more.
# REPLAY_LIVE_MARGIN_MS=1500
